---
import AppLayout from "@/layouts/AppLayout.astro";
import AirlineFrame from "@/components/AirlineFrame.astro";
import AirlineSettings from "@/components/AirlineSettings.vue";
import { getLocale, getMessages, useTranslations } from "@/lib/i18n";
import { currentMe } from "@/server/session";
import { getVa } from "@/server/canVa";
import { loadAirlinePage } from "@/server/airlinePage";
import { can } from "@/lib/permissions";
import type { Member } from "@/lib/va";

/** 航司设置。没有 `airline.edit` 的人拿到 404 页；写权限由 can-va-api 判。 */
const me = currentMe(Astro.locals);
const page = await loadAirlinePage(Astro, Astro.params.icao, me);
if (!page || !can(page.membership, "airline.edit")) {
  return Astro.rewrite("/404");
}

const locale = getLocale(Astro.cookies);
const t = useTranslations(locale, "manage");
const isOwner = page.membership?.isOwner ?? false;
const active = isOwner
  ? await getVa<{ items: Member[] }>(
      Astro,
      `/api/v1/va/airlines/${page.icao}/members?status=active`,
    )
  : null;
const candidates = (active?.items ?? [])
  .map((m) => m.username)
  .filter((username) => username !== me.username);
---

<AppLayout title={`${t("title")} · ${page.airline.name}`}>
  <AirlineFrame page={page} current="manage" description={t("description")}>
    <AirlineSettings
      airline={page.airline}
      isOwner={isOwner}
      candidates={candidates}
      messages={getMessages(locale, "manage")}
      picker={getMessages(locale, "airportPicker")}
      common={getMessages(locale, "common")}
      client:load
    />
  </AirlineFrame>
</AppLayout>
