---
import AppLayout from "@/layouts/AppLayout.astro";
import AirlineFrame from "@/components/AirlineFrame.astro";
import MembersManager from "@/components/MembersManager.vue";
import { getLocale, getMessages, useTranslations } from "@/lib/i18n";
import { currentMe } from "@/server/session";
import { getVa } from "@/server/canVa";
import { loadAirlinePage } from "@/server/airlinePage";
import { can } from "@/lib/permissions";
import type { Member, Role } from "@/lib/va";

/** 成员名单只给活跃成员（上游 `GET members` 的门槛）。 */
const me = currentMe(Astro.locals);
const page = await loadAirlinePage(Astro, Astro.params.icao, me);
const membership = page?.membership;
if (!page || !membership || membership.status !== "active") {
  return Astro.rewrite("/404");
}

const locale = getLocale(Astro.cookies);
const t = useTranslations(locale, "members");
const canManage = can(membership, "members.manage");
const base = `/api/v1/va/airlines/${page.icao}`;
const [roles, active, applied, invited] = await Promise.all([
  getVa<{ items: Role[] }>(Astro, `${base}/roles`),
  getVa<{ items: Member[] }>(Astro, `${base}/members?status=active`),
  canManage
    ? getVa<{ items: Member[] }>(Astro, `${base}/members?status=applied`)
    : null,
  canManage
    ? getVa<{ items: Member[] }>(Astro, `${base}/members?status=invited`)
    : null,
]);
---

<AppLayout title={`${t("title")} · ${page.airline.name}`}>
  <AirlineFrame page={page} current="members" description={t("description")}>
    <MembersManager
      icao={page.icao}
      self={me.username}
      membership={membership}
      canManage={canManage}
      roles={roles?.items ?? []}
      active={active?.items ?? []}
      applied={applied?.items ?? []}
      invited={invited?.items ?? []}
      messages={getMessages(locale, "members")}
      common={getMessages(locale, "common")}
      client:load
    />
  </AirlineFrame>
</AppLayout>
