---
import AppLayout from "@/layouts/AppLayout.astro";
import AirlineFrame from "@/components/AirlineFrame.astro";
import RanksManager from "@/components/RanksManager.vue";
import { getLocale, getMessages, useTranslations } from "@/lib/i18n";
import { currentMe } from "@/server/session";
import { getVa } from "@/server/canVa";
import { loadAirlinePage } from "@/server/airlinePage";
import { can } from "@/lib/permissions";
import type { Rank } from "@/lib/va";

/** 等级表谁都看得到；改要 `ranks.manage`。 */
const me = currentMe(Astro.locals);
const page = await loadAirlinePage(Astro, Astro.params.icao, me);
if (!page) return Astro.rewrite("/404");

const locale = getLocale(Astro.cookies);
const t = useTranslations(locale, "ranks");
const ranks = await getVa<{ items: Rank[] }>(
  Astro,
  `/api/v1/va/airlines/${page.icao}/ranks`,
);
---

<AppLayout title={`${t("title")} · ${page.airline.name}`}>
  <AirlineFrame page={page} current="ranks" description={t("description")}>
    <RanksManager
      icao={page.icao}
      locale={locale}
      canManage={can(page.membership, "ranks.manage")}
      ranks={ranks?.items ?? []}
      messages={getMessages(locale, "ranks")}
      common={getMessages(locale, "common")}
      client:load
    />
  </AirlineFrame>
</AppLayout>
