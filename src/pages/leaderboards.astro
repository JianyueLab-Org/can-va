---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import PilotOperations from "@/components/PilotOperations.vue";
import { getLocale, getMessages, useTranslations } from "@/lib/i18n";
import { currentMe } from "@/server/session";
import { getVa } from "@/server/canVa";
import type { LeaderboardEntry } from "@/lib/va";
const me = currentMe(Astro.locals),
  locale = getLocale(Astro.cookies),
  t = useTranslations(locale, "ops");
const board = await getVa<{ items: LeaderboardEntry[] }>(
  Astro,
  "/api/v1/va/leaderboards?metric=hours&period=month",
);
---

<AppLayout title={t("leaderboards")}
  ><PageHeader title={t("leaderboards")} /><PilotOperations
    mode="leaderboards"
    username={me.username}
    entries={board?.items ?? []}
    locale={locale}
    messages={getMessages(locale, "ops")}
    common={getMessages(locale, "common")}
    client:load
  /></AppLayout
>
