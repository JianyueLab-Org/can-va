---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import FlightOperations from "@/components/FlightOperations.vue";
import { getLocale, getMessages } from "@/lib/i18n";
import { currentMe } from "@/server/session";
import { getVa } from "@/server/canVa";
import { can, membershipFor } from "@/lib/permissions";
import type { Booking, Pirep, Airline } from "@/lib/va";
const me = currentMe(Astro.locals),
  id = Astro.params.id;
if (!id || !/^\d+$/.test(id)) return Astro.rewrite("/404");
const detail = await getVa<Pirep>(Astro, `/api/v1/va/pireps/${id}`);
if (!detail) return Astro.rewrite("/404");
const locale = getLocale(Astro.cookies),
  membership = membershipFor(me, detail.airlineIcao);
const current = await getVa<Booking>(Astro, "/api/v1/va/me/booking");
const airline = current
  ? await getVa<Airline>(Astro, `/api/v1/va/airlines/${current.airlineIcao}`)
  : null;
---

<AppLayout title={detail.callsign}
  ><PageHeader title={detail.callsign} /><FlightOperations
    icao={detail.airlineIcao}
    username={me.username}
    location={me.pilot?.locationIcao ?? null}
    current={null}
    history={{ items: [], next: null }}
    reports={{ items: [], next: null }}
    detail={detail}
    review={can(membership, "pireps.review")}
    manageFleet={can(membership, "fleet.manage")}
    allowOffline={airline?.allowOfflinePireps ?? false}
    locale={locale}
    messages={getMessages(locale, "ops")}
    common={getMessages(locale, "common")}
    client:load
  /></AppLayout
>
