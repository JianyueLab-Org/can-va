---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import PilotOperations from "@/components/PilotOperations.vue";
import { getLocale, getMessages, useTranslations } from "@/lib/i18n";
import { currentMe } from "@/server/session";
import { getVa } from "@/server/canVa";
import type { PilotProfile } from "@/lib/va";
const me = currentMe(Astro.locals),
  locale = getLocale(Astro.cookies),
  t = useTranslations(locale, "ops");
const profile = me.pilot
  ? await getVa<PilotProfile>(Astro, `/api/v1/va/pilots/${me.username}`)
  : null;
---

<AppLayout title={t("profile")}
  ><PageHeader title={t("profile")} />{
    !me.pilot ? (
      <p class="text-muted">{t("joinFirst")}</p>
    ) : (
      <PilotOperations
        mode="profile"
        username={me.username}
        profile={profile}
        locale={locale}
        messages={getMessages(locale, "ops")}
        common={getMessages(locale, "common")}
        client:load
      />
    )
  }</AppLayout
>
