---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import ApplyForm from "@/components/ApplyForm.vue";
import { getLocale, getMessages, useTranslations } from "@/lib/i18n";
import { currentMe } from "@/server/session";
import { getVa } from "@/server/canVa";
import type { Application } from "@/lib/va";

const me = currentMe(Astro.locals);
const locale = getLocale(Astro.cookies);
const t = useTranslations(locale, "apply");
const mine = await getVa<{ items: Application[] }>(
  Astro,
  "/api/v1/va/applications/mine",
);
---

<AppLayout title={t("title")}>
  <div class="w-full">
    <PageHeader title={t("title")} description={t("description")} />
    <ApplyForm
      pending={me.pendingApplication}
      history={mine?.items ?? []}
      messages={getMessages(locale, "apply")}
      picker={getMessages(locale, "airportPicker")}
      common={getMessages(locale, "common")}
      client:load
    />
  </div>
</AppLayout>
