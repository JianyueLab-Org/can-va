---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import PilotOperations from "@/components/PilotOperations.vue";
import { getLocale, getMessages } from "@/lib/i18n";
import { getVa } from "@/server/canVa";
import type { PilotProfile } from "@/lib/va";
const username = Astro.params.username;
if (!username || !/^[A-Za-z0-9_-]{1,32}$/.test(username))
  return Astro.rewrite("/404");
const profile = await getVa<PilotProfile>(
  Astro,
  `/api/v1/va/pilots/${username}`,
);
if (!profile) return Astro.rewrite("/404");
const locale = getLocale(Astro.cookies);
---

<AppLayout title={username}
  ><PageHeader title={username} /><PilotOperations
    mode="profile"
    username={username}
    profile={profile}
    locale={locale}
    messages={getMessages(locale, "ops")}
    common={getMessages(locale, "common")}
    client:load
  /></AppLayout
>
